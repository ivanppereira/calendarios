# Copie este arquivo para .env.local (uso local) e/ou configure as mesmas
# variáveis em Vercel > Project Settings > Environment Variables.
#
# Onde encontrar esses valores: no painel do Supabase, vá em
# Project Settings > API.

# --- usadas só no servidor (rotas em app/api/...) — NUNCA aparecem no navegador ---
# Use a "Project URL" e a chave "service_role".
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-chave-service_role

# --- usadas no navegador, para a colaboração em tempo real (Realtime/Presence) ---
# Mesma Project URL de cima. Use a chave "anon public" (é feita para ser pública).
# Sem essas duas, o app funciona normalmente (autosave incluso), só sem a
# sincronização ao vivo entre quem está editando o mesmo calendário.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-aqui-a-chave-anon-public
